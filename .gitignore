# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-version

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Experiment outputs: keep summary markdown, ignore bulk artifacts.
# Directories must be re-included first: git never descends into an
# excluded directory, so `!.../summary.md` alone can not re-include.
results/**
!results/**/
!results/.gitkeep
!results/**/summary.md
# --quick smoke runs are not results; never track their summaries
results/*_quick/
experiments/**/out/

# IBM Quantum / hardware credentials — NEVER commit
*.env
.env*
qiskit-ibm.json
**/ibm_token*

# Paper PDFs (downloaded via docs/papers/get_papers.sh)
docs/papers/pdf/

# Matplotlib cache (created by headless experiment runs)
.mplconfig/

# OS / editor
.DS_Store
.vscode/
.idea/
